{
  "type": "object",
  "required": [
    "id",
    "schemaName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "title": "Record identifier",
      "description": "NKR identifier of the record (autogenerated)",
      "cordra": {
        "type": {
          "autoGeneratedField": "handle"
        }
      }
    },
    "schemaName": {
      "type": "string",
      "maxLength": 128,
      "title": "Name of the metadata schema",
      "description": "Official name of the metadata schema in the original language.",
      "cordra": {
        "preview": {
          "showInPreview": true,
          "isPrimary": true
        }
      }
    },
    "controlledVocabulary": {
      "type": "array",
      "title": "Controlled vocabularies",
      "description": "Controlled vocabularies used in the repository. Provide a link to an object of type ControlledVocab.",
      "items": {
        "type": "string",
        "title": "Vocabulary",
        "cordra": {
          "type": {
            "handleReference": {
              "types": [
                "ControlledVocab"
              ]
            }
          }
        }
      }
    }
  }
}
