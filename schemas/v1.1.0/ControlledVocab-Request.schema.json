{
  "type": "object",
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "cordra": {
        "type": {
          "autoGeneratedField": "handle"
        }
      }
    },
    "handleUrl": {
      "type": "string",
      "format": "uri",
      "title": "Handle identifier",
      "description": "Persistent identifier for the record.",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "title": "Name",
      "maxLength": 256,
      "cordra": {
        "preview": {
          "showInPreview": true,
          "isPrimary": true
        }
      }
    },
    "description": {
      "type": "string",
      "title": "Description",
      "format": "textarea",
      "description": "Maps to the property dc:description"
    },
    "creator": {
      "type": "string",
      "title": "Organisation Creator",
      "description": "Maps to the property dc:creator",
      "maxLength": 256,
      "cordra": {
        "preview": {
          "showInPreview": true,
          "isPrimary": true
        }
      }
    },
    "urlSourceReference": {
      "type": "string",
      "format": "uri",
      "title": "External source URL",
      "description": "Maps to the dc:source property at the vocabulary level."
    },
    "urlReference": {
      "type": "array",
      "title": "URLs for the external vocabulary",
      "description": "Maps to the property rdf:seeAlso.",
      "items": {
        "type": "string",
        "title": "URL",
        "format": "uri"
      }
    },
    "urlBartoc": {
      "type": "string",
      "format": "uri",
      "title": "Bartoc URL",
      "description": "URL of the BARTOC registry. Maps to the property rdf:seeAlso. "
    },
    "urlConceptScheme": {
      "type": "string",
      "format": "uri",
      "title": "Concept scheme URL",
      "description": "Maps to the property skos:ConceptScheme. If not available, leave blank and it will be assigned by the NKR"
    },
    "technicalArtifacts": {
      "type": "array",
      "format": "table",
      "uniqueItems": true,
      "title": "SKOS technical artifacts",
      "description": "SKOS technical artifacts for the vocabulary. May be in the CSV, TTL, RDF/XML or JSON-LD formats.",
      "items": {
        "type": "object",
        "title": "Technical Artifact",
        "required": [
          "technicalArtifactUrl",
          "technicalArtifactFormat"
        ],
        "properties": {
          "technicalArtifactUrl": {
            "title": "Technical artifact URL",
            "type": "string",
            "format": "uri"
          },
          "technicalArtifactFormat": {
            "title": "Format",
            "type": "string",
            "description": "Format of the technical artifact",
            "enum": [
              "CSV",
              "TTL",
              "RDF/XML",
              "JSON-LD",
              "other"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "submitted",
        "under review",
        "approved",
        "rejected"
      ],
      "default": "draft",
      "cordra": {
        "preview": {
          "showInPreview": true
        }
      }
    },
    "repository": {
      "type": "array",
      "title": "Repository",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "title": "Repository reference",
        "cordra": {
          "type": {
            "handleReference": {
              "types": [
                "Repository"
              ]
            }
          }
        }
      }
    },
    "controlledVocabulary": {
      "type": "string",
      "title": "Approved as",
      "description": "Approved as controlled vocabulary. Provide a link to an object of type ControlledVocab.",
      "cordra": {
        "type": {
          "handleReference": {
            "types": [
              "ControlledVocab"
            ]
          }
        }
      }
    },
    "contactPerson": {
      "type": "array",
      "title": "Contact person",
      "format": "table",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "maxLength": 256
          },
          "email": {
            "type": "string",
            "title": "Email",
            "format": "email",
            "maxLength": 320
          },
          "affiliation": {
            "type": "string",
            "title": "Affiliation",
            "maxLength": 256
          }
        }
      }
    },
    "curatorComment": {
      "type": "string",
      "title": "NKR curator comment",
      "format": "textarea"
    }
  }
}